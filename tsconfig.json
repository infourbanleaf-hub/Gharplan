{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "jsx": "react-native",
    "lib": [
      "ES2020",
      "DOM"
    ]
  },
  "include": [
    "engine",
    "config",
    "render",
    "ui",
    "tests",
    "scripts",
    "App.tsx",
    "index.ts"
  ],
  "extends": "expo/tsconfig.base"
}
